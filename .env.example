# ─── Site ────────────────────────────────────────────────────────────────────
# Set this to your live domain before deploying
NEXT_PUBLIC_SITE_URL=https://www.ethiopiafilmfixer.com

# ─── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
# Add via @next/third-parties: <GoogleAnalytics gaId={process.env.NEXT_PUBLIC_GA_ID} />
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Email / Nodemailer (SMTP) ────────────────────────────────────────────────
# Used by /api/contact to send form submissions
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-authenticated-email@domain.com
EMAIL_PASS=your-app-password-or-smtp-pass
EMAIL_TO=production@ethiopiafilmfixer.com

# ─── reCAPTCHA (optional spam protection) ────────────────────────────────────
# Sign up at google.com/recaptcha — use v3 for invisible protection
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Connection String (leave blank for local development or fill for prod)
MONGODB_URI=
